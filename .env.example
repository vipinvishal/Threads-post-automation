# ── Gemini AI (post generation) ──────────────────────────────────────────────
# Get keys: https://aistudio.google.com/apikey
# GEMINI_API_KEY_2 is optional — auto-used when primary hits daily quota
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here

# Optional: override model (default: gemini-2.5-flash in CI)
# GEMINI_MODEL=gemini-2.5-flash
# EURON_MODEL=gemini-2.5-flash

# ── Euron fallback (used when ALL Gemini keys are exhausted) ──────────────────
# Get key: https://euron.one
EURON_API_KEY=your_euron_api_key_here

# ── Exa (real-time neural web research) ──────────────────────────────────────
# Get key: https://exa.ai → Dashboard → API Keys
EXA_API_KEY=your_exa_api_key_here

# ── Buffer (schedules posts to X) ────────────────────────────────────────────
# Get API key: https://buffer.com → Settings → API
# Get Channel ID: run  python scripts/get_buffer_channel.py
BUFFER_API_KEY=your_buffer_api_key_here
BUFFER_CHANNEL_ID=your_buffer_x_channel_id_here

# ── imgbb (hosts the infographic PNG so Buffer can attach it) ─────────────────
# Free key: https://api.imgbb.com/  (if unset, posts fall back to text-only)
IMGBB_API_KEY=your_imgbb_api_key_here

# ── Infographic / post identity ──────────────────────────────────────────────
# Handle shown on the infographic and in the follow CTA
INFOGRAPHIC_HANDLE=@vipin.vishal
# FOLLOW_CTA=Follow @vipin.vishal for 1 AI insight/day.
# Portfolio URL. Appended to the post body as a directly CLICKABLE link (Threads
# auto-links it), AND shown as text in the infographic footer. Note: a link in the
# body reduces Threads reach — the trade-off for a tappable link. Set "" to disable
# the clickable link (the infographic keeps showing the non-clickable URL).
PORTFOLIO_URL=vipin-vishal.onrender.com

# Optional: bias the content-slot rotation
# SLOT_WEIGHTS=news:2,educational:3,personal:1,advanced:2

# Set to 0 for text-only posts (no infographic)
# INCLUDE_INFOGRAPHIC=1
